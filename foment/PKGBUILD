_realname=foment
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.4.1.r563
pkgrel=1
pkgdesc="An implementation of R7RS Scheme. "
arch=('any')
url="https://github.com/leftmike/foment"
license=('MIT')
depends=()
makedepends=("${MINGW_PACKAGE_PREFIX}-gcc" "coreutils" "${MINGW_PACKAGE_PREFIX}-make")
source=("foment-6089c3c.tar.gz::https://codeload.github.com/leftmike/foment/tar.gz/6089c3c9e762875f619ef382d27943819bbe002b"
        "foment-mingw.patch"
        "makefile.mingw")
sha256sums=('a867a23501705a7a64a9c29d780294fc1f6f03f18a20c0c03e6ffbbf87810cc8'
            'SKIP'
            'SKIP')

prepare() {
  cd ${srcdir}/foment-6089c3c9e762875f619ef382d27943819bbe002b
  patch -p1 -i ${srcdir}/foment-mingw.patch
  cp ${srcdir}/makefile.mingw ./windows/

}

build() {
  cd ${srcdir}/foment-6089c3c9e762875f619ef382d27943819bbe002b/windows
  mkdir -p release
  mkdir -p debug
  mkdir -p profile
  mingw32-make -f makefile.mingw debug/genprops
  mingw32-make -f makefile.mingw release/foment
}

package() {
  cd ${srcdir}/foment-6089c3c9e762875f619ef382d27943819bbe002b
  install -D -s windows/release/foment.exe ${pkgdir}/${MINGW_PREFIX}/bin/foment.exe
}
