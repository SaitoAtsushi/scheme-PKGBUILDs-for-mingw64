_realname=OtusLisp
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.7
pkgrel=1
pkgdesc="Otus Lisp (Ol in short) is a purely* functional dialect of Lisp."
arch=('any')
url="https://github.com/yuriy-chumak/ol"
license=('GPL3' 'MIT')
depends=()
makedepends=("${MINGW_PACKAGE_PREFIX}-gcc" "${MINGW_PACKAGE_PREFIX}-make" "sed")
options=('staticlibs')
source=("ol-2.7.tar.gz::https://github.com/yuriy-chumak/ol/archive/refs/tags/2.7.tar.gz")
sha256sums=('32dec0d527d456cce3273b907ffface6386a61288edf33f8724e2dd1bfb22319')

prepare() {
  cd ${srcdir}/ol-${pkgver}
  sed -i -e "s/^\tcp $< $@/\tinstall -s $< $@/" -e "s/^\tstrip $@//" GNUmakefile
}

build() {
  cd ${srcdir}/ol-${pkgver}
  mingw32-make PREFIX=${MINGW_PREFIX} CC=gcc L=-lws2_32 CFLAGS="-Iincludes/win32 -DIN_WINPTHREAD -Dclockid_t=int -DCLOCK_REALTIME=0 -DCLOCK_MONOTONIC=1 -D_WIN32 -D_DEFAULT_SOURCE" HAS_SOCKETS=1 HAS_DLOPEN=0
}

package() {
  cd ${srcdir}/ol-${pkgver}
  make DESTDIR=${pkgdir} PREFIX=${MINGW_PREFIX} install
}
