pkgbase=tr7
pkgname="${MINGW_PACKAGE_PREFIX}-${pkgbase}"
pkgver=2.0.19
pkgrel=1
pkgdesc="Tiny R7RS-small scheme interpreter"
arch=('any')
url="https://gitlab.com/jobol/tr7"
license=('ISCL')
depends=()
makedepends=("${MINGW_PACKAGE_PREFIX}-gcc" "${MINGW_PACKAGE_PREFIX}-make")
source=("https://gitlab.com/jobol/tr7/-/archive/v2.0.19/tr7-v2.0.19.tar.gz"
        "tr7-mingw.patch")
sha256sums=('da74d276bcb8e545e391ee0fa85e851b8771692156c3d0ca6f333e029a8e6a94'
            'SKIP')

prepare() {
  cd "${srcdir}/tr7-v${pkgver}"
  patch -p1 -i "${srcdir}/tr7-mingw.patch"
}

build() {
  cd "${srcdir}/tr7-v${pkgver}"
  make PREFIX=${MINGW_PREFIX}
}

package() {
  cd "${srcdir}/tr7-v${pkgver}"
  make install DESTDIR="${pkgdir}" PREFIX=${MINGW_PREFIX}
}
